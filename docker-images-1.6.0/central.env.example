# DockerMind Central — skopiuj jako .env
AI_BASE_URL=https://ai.example.local/v1
AI_MODEL=llama3
AI_API_TOKEN=uzupelnij-token-ai

CT_USERNAME=admin
CT_PASSWORD=zmien-na-silne-haslo
CT_SECRET_KEY=zmien-na-losowy-klucz-minimum-32-znaki
AGENT_SECRET_TOKEN=zmien-na-losowy-token-minimum-32-znaki

# Opcjonalnie
# BIND_ADDRESS=0.0.0.0
# HTTP_PORT=80
# SMTP_HOST=
