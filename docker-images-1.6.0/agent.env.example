# DockerMind Agent — skopiuj jako .env na monitorowanym hoście
CENTRAL_URL=wss://centrala.example.local:8443/ws/agent
AGENT_TOKEN=ten-sam-token-co-AGENT_SECRET_TOKEN-w-centrali
AGENT_NAME=serwer-produkcyjny-01

# Opcjonalnie, jeśli agent ma raportować konkretny adres
# AGENT_IP=192.168.1.100

# Wymagane dla terminala hosta i wspólnych komend
HOST_ACCESS_ENABLED=true

# Opcjonalny certyfikat CA centrali
# CENTRAL_CA_CERT=/etc/dockermind/certs/ca.pem
