CENTRAL_URL=wss://dockermind.example.local:8443/ws/agent
AGENT_TOKEN=tajny-token-minimum-32-znaki-zmien-to
AGENT_NAME=serwer-produkcyjny-01
CENTRAL_CA_CERT=/etc/dockermind/certs/central-ca.pem

# Opcjonalne - nadpisuje auto-wykryty IP hosta
# AGENT_IP=192.168.1.100

# Udostępnia administratorom terminal systemu hosta przez panel.
# Domyślnie wyłączone — ustaw true tylko na serwerach, na których jest to potrzebne.
HOST_ACCESS_ENABLED=false
